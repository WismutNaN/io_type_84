  "sourceSections": [
    {
      "id": "O01",
      "section": 1,
      "title": "Какие сущности действительно нужны"
    },
    {
      "id": "O02",
      "section": 2,
      "title": "Control: я бы отделил физическую клавишу от логической функции"
    },
    {
      "id": "O03",
      "section": 3,
      "title": "Signal — магнитная клавиатура даёт не событие, а сигнал"
    },
    {
      "id": "O04",
      "section": 4,
      "title": "Trigger лучше назвать Interaction / Recognizer"
    },
    {
      "id": "O05",
      "section": 5,
      "title": "У Trigger должны быть фазы"
    },
    {
      "id": "O06",
      "section": 6,
      "title": "Основные типы Trigger / Recognizer"
    },
    {
      "id": "O07",
      "section": 7,
      "title": "В Trigger обязательно должна входить направленность"
    },
    {
      "id": "O08",
      "section": 8,
      "title": "Condition — отдельная сущность, не Trigger"
    },
    {
      "id": "O09",
      "section": 9,
      "title": "Condition должен собираться из блоков AND / OR / NOT"
    },
    {
      "id": "O10",
      "section": 10,
      "title": "State / Variable — обязательная сущность"
    },
    {
      "id": "O11",
      "section": 11,
      "title": "Rule — вот это фактически основной пользовательский объект"
    },
    {
      "id": "O12",
      "section": 12,
      "title": "Policies — небольшая сущность, но критически важная"
    },
    {
      "id": "O13",
      "section": 13,
      "title": "Actions должны быть атомарными"
    },
    {
      "id": "O14",
      "section": 14,
      "title": "Flow — контейнер для вложенных действий"
    },
    {
      "id": "O15",
      "section": 15,
      "title": "Нужна сущность Runtime Action / Lease"
    },
    {
      "id": "O16",
      "section": 16,
      "title": "Lifetime можно сделать понятным пользовательским свойством"
    },
    {
      "id": "O17",
      "section": 17,
      "title": "Tap/Hold — это не два независимых Trigger"
    },
    {
      "id": "O18",
      "section": 18,
      "title": "Pending — важное состояние"
    },
    {
      "id": "O19",
      "section": 19,
      "title": "Combo, Sequence и Chord — тоже recognizer'ы"
    },
    {
      "id": "O20",
      "section": 20,
      "title": "Sequence — отдельный тип"
    },
    {
      "id": "O21",
      "section": 21,
      "title": "One Shot — уже State Machine"
    },
    {
      "id": "O22",
      "section": 22,
      "title": "SOCD / Rappy Snappy вообще не стоит представлять Trigger → Action"
    },
    {
      "id": "O23",
      "section": 23,
      "title": "Resolver пригодится не только для SOCD"
    },
    {
      "id": "O24",
      "section": 24,
      "title": "Profile, Layer, Scope и Context нельзя объединять"
    },
    {
      "id": "O25",
      "section": 25,
      "title": "Нужен reusable Behavior / Automation"
    },
    {
      "id": "O26",
      "section": 26,
      "title": "Stream Deck даёт ещё одну важную сущность: Action Type против Action Instance"
    },
    {
      "id": "O27",
      "section": 27,
      "title": "И неожиданно новый Stream Deck 7 подтверждает нашу модель"
    },
    {
      "id": "O28",
      "section": 28,
      "title": "Как существующие «функции» раскладываются на наши сущности"
    },
    {
      "id": "O29",
      "section": 29,
      "title": "Как я бы оформил самое важное место GUI"
    },
    {
      "id": "O30",
      "section": 30,
      "title": "А сложные пресеты просто генерируют такие правила"
    },
    {
      "id": "O31",
      "section": 31,
      "title": "Advanced mode показывает правду"
    },
    {
      "id": "O32",
      "section": 32,
      "title": "Отдельно нужен Debugger"
    },
    {
      "id": "O33",
      "section": 33,
      "title": "Что я бы сознательно НЕ делал"
    }
  ],
